<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  🎮 下行控制面板"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
        android:outlineAmbientShadowColor="#1A000000"
        android:outlineSpotShadowColor="#0D000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💡 LED 灯光"
                        android:textSize="14sp"
                        android:textColor="#37474F" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnLedOn"
                            android:layout_width="64dp"
                            android:layout_height="38dp"
                            android:text="开"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#4CAF50"
                            android:layout_marginEnd="10dp" />

                        <Button
                            android:id="@+id/btnLedOff"
                            android:layout_width="64dp"
                            android:layout_height="38dp"
                            android:text="关闭"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#9E9E9E" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔊 蜂鸣器"
                    android:textSize="14sp"
                        android:textColor="#37474F" />

                    <Switch
                        android:id="@+id/swBeep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌀 风扇"
                        android:textSize="14sp"
                        android:textColor="#37474F" />

                    <Switch
                        android:id="@+id/swFan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔄 工作模式"
                        android:textSize="14sp"
                        android:textColor="#37474F" />

                    <ToggleButton
                        android:id="@+id/tbtnWorkMode"
                        android:layout_width="100dp"
                        android:layout_height="38dp"
                        android:textOn="手动"
                        android:textOff="自动"
                        android:textSize="13sp"
                        android:backgroundTint="#9C27B0"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  ⚠️ 阈值参数设置"
                    android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
        android:outlineAmbientShadowColor="#1A000000"
        android:outlineSpotShadowColor="#0D000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="温度阈值 (10-50°C)"
                            android:textSize="13sp"
                            android:textColor="#E53935"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTempThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25°C"
                            android:textSize="13sp"
                            android:textColor="#E53935"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbTempThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="40"
                        android:progress="15"
                        android:layout_marginTop="8dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etTempThreshold"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:hint="输入 10-50"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:maxLength="2"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/bg_edit_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTempThreshold"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:minWidth="76dp"
                            android:text="确定"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#E53935"
                            app:cornerRadius="8dp"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="烟雾阈值 (0-4000)"
                            android:textSize="13sp"
                            android:textColor="#795548"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSmokeThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1500"
                            android:textSize="13sp"
                            android:textColor="#795548"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbSmokeThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="4000"
                        android:progress="1500"
                        android:layout_marginTop="8dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etSmokeThreshold"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:hint="输入 0-4000"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:maxLength="4"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/bg_edit_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSmokeThreshold"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:minWidth="76dp"
                            android:text="确定"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#795548"
                            app:cornerRadius="8dp"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PM2.5 阈值 (0-500)"
                            android:textSize="13sp"
                            android:textColor="#7B1FA2"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPm25ThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="200 μg/m³"
                            android:textSize="13sp"
                            android:textColor="#7B1FA2"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbPm25Threshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="500"
                        android:progress="200"
                        android:layout_marginTop="8dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etPm25Threshold"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:hint="输入 0-500"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:maxLength="3"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/bg_edit_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPm25Threshold"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:minWidth="76dp"
                            android:text="确定"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#7B1FA2"
                            app:cornerRadius="8dp"
                            android:layout_marginStart="10dp" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  🎯 舵机角度调节"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
        android:outlineAmbientShadowColor="#1A000000"
        android:outlineSpotShadowColor="#0D000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="舵机角度 (0-180°)"
                        android:textSize="13sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSteeringAngleValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90°"
                        android:textSize="13sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbSteeringAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="180"
                    android:progress="90"
                    android:layout_marginTop="8dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSteeringAngle"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:minWidth="76dp"
                        android:text="确定"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1565C0"
                        app:cornerRadius="8dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E3F2FD"
        android:outlineAmbientShadowColor="#1A000000"
        android:outlineSpotShadowColor="#0D000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 操作说明"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#90CAF9"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 LED控制：开关充电棚照明灯\n🔊 蜂鸣器：触发声音告警\n🌀 风扇：控制散热风扇启停\n🔄 工作模式：切换自动/手动模式\n⚠️ 阈值设置：调整各传感器报警阈值\n⚙️ 舵机角度：调节舵机物理角度(0-180°)"
                    android:textSize="12sp"
                    android:textColor="#37474F"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

<androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFEBEE"
        android:outlineAmbientShadowColor="#1A000000"
        android:outlineSpotShadowColor="#0D000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔒 退出登录"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#C62828" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:text="退出"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#E53935"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>