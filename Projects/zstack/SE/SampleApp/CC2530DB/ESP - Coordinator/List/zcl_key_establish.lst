   1633          /*********************************************************************
   1634           * @fn      zclGeneral_AgeKeyEstablishRec
   1635           *
   1636           * @brief   Function to age Key Establish Rec. This function is called
   1637           *          as event handler for KEY_ESTABLISHMENT_REC_AGING_EVT every 
   1638           *          second.
   1639           *
   1640           * @param   none
   1641           *
   1642           * @return  none
   1643           */
   1644          static void zclGeneral_AgeKeyEstablishRec( void )
   1645          {
   1646            uint8 i;
   1647            
   1648            for ( i = 0; i < MAX_KEY_ESTABLISHMENT_REC_ENTRY; i++ )
   1649            { 
   1650              // Only age valid rec entry 
   1651              if (keyEstablishRec[i].dstAddr.addrMode == afAddrNotPresent)
   1652                continue;
   1653          
   1654              if (--(keyEstablishRec[i].age) == 0)
   1655              {
   1656                keyEstablishRec[i].dstAddr.addrMode = afAddrNotPresent;
   1657                keyEstablishRec[i].dstAddr.addr.shortAddr = INVALID_PARTNER_ADDR;
   1658              }
   1659            }
   1660          }
