   \   00000F   A3           INC     DPTR
   \   000010   74..         MOV     A,#(??StubAPS_ZMacCallback?relay >> 8) & 0xff
   \   000012   F0           MOVX    @DPTR,A
    136            
    137          } /* StubAPS_Init() */
