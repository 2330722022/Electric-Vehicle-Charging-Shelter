     70          // The order in this table must be identical to the task initialization calls below in osalInitTask.

   \                                 In  segment XDATA_ROM_C, align 1
     71          const pTaskEventHandlerFn tasksArr[] = {
   \                     tasksArr:
   \   000000   ....         DW ??macEventLoop?relay
   \   000002   ....         DW ??nwk_event_loop?relay
   \   000004   ....         DW ??Hal_ProcessEvent?relay
   \   000006   ....         DW ??MT_ProcessEvent?relay
   \   000008   ....         DW ??APS_event_loop?relay
   \   00000A   ....         DW ??APSF_ProcessEvent?relay
   \   00000C   ....         DW ??ZDApp_event_loop?relay
   \   00000E   ....         DW ??ZDNwkMgr_event_loop?relay
   \   000010   ....         DW ??zcl_event_loop?relay
   \   000012   ....         DW ??zclKeyEstablish_event_loop?relay
   \   000014   ....         DW ??esp_event_loop?relay
     72            macEventLoop,
     73            nwk_event_loop,
     74            Hal_ProcessEvent,
     75          #if defined( MT_TASK )
     76            MT_ProcessEvent,
     77          #endif
     78            APS_event_loop,
     79          #if defined ( ZIGBEE_FRAGMENTATION )
     80            APSF_ProcessEvent,
     81          #endif
     82            ZDApp_event_loop,
     83          #if defined ( ZIGBEE_FREQ_AGILITY ) || defined ( ZIGBEE_PANID_CONFLICT )
     84            ZDNwkMgr_event_loop,
     85          #endif
     86            zcl_event_loop,
     87          #if defined ( ZCL_KEY_ESTABLISH )
     88            zclKeyEstablish_event_loop,
     89          #endif
     90            esp_event_loop
     91          };
     92          

   \                                 In  segment XDATA_ROM_C, align 1
     93          const uint8 tasksCnt = sizeof( tasksArr ) / sizeof( tasksArr[0] );
   \                     tasksCnt:
   \   000000   0B           DB 11

   \                                 In  segment XDATA_Z, align 1, keep-with-next
     94          uint16 *tasksEvents;
   \                     tasksEvents:
   \   000000                DS 2
   \   000002                REQUIRE __INIT_XDATA_Z
     95          
     96          /*********************************************************************
     97           * FUNCTIONS
     98           *********************************************************************/
     99          
    100          /*********************************************************************
    101           * @fn      osalInitTasks
    102           *
    103           * @brief   This function invokes the initialization function for each task.
    104           *
    105           * @param   void
    106           *
    107           * @return  none
    108           */

   \                                 In  segment BANKED_CODE, align 1, keep-with-next
    109          void osalInitTasks( void )
   \                     osalInitTasks:
    110          {
   \   000000   C082         PUSH    DPL
   \   000002   C083         PUSH    DPH
   \   000004                ; Saved register size: 2
   \   000004                ; Auto size: 0
    111            uint8 taskID = 0;
    112          
    113            tasksEvents = (uint16 *)osal_mem_alloc( sizeof( uint16 ) * tasksCnt);
   \   000004                ; Setup parameters for call to function osal_mem_alloc
   \   000004   7A16         MOV     R2,#0x16
   \   000006   7B00         MOV     R3,#0x0
   \   000008   12....       LCALL   ??osal_mem_alloc?relay
   \   00000B   90....       MOV     DPTR,#tasksEvents
   \   00000E   EA           MOV     A,R2
   \   00000F   F0           MOVX    @DPTR,A
   \   000010   A3           INC     DPTR
   \   000011   EB           MOV     A,R3
   \   000012   F0           MOVX    @DPTR,A
    114            osal_memset( tasksEvents, 0, (sizeof( uint16 ) * tasksCnt));
   \   000013                ; Setup parameters for call to function osal_memset
   \   000013   7C16         MOV     R4,#0x16
   \   000015   7D00         MOV     R5,#0x0
   \   000017   7900         MOV     R1,#0x0
   \   000019   12....       LCALL   ??osal_memset?relay
    115          
    116            macTaskInit( taskID++ );
   \   00001C                ; Setup parameters for call to function macTaskInit
   \   00001C   7900         MOV     R1,#0x0
   \   00001E   12....       LCALL   ??macTaskInit?relay
    117            nwk_init( taskID++ );
   \   000021                ; Setup parameters for call to function nwk_init
   \   000021   7901         MOV     R1,#0x1
   \   000023   12....       LCALL   ??nwk_init?relay
    118            Hal_Init( taskID++ );
   \   000026                ; Setup parameters for call to function Hal_Init
   \   000026   7902         MOV     R1,#0x2
   \   000028   12....       LCALL   ??Hal_Init?relay
    119          #if defined( MT_TASK )
    120            MT_TaskInit( taskID++ );
   \   00002B                ; Setup parameters for call to function MT_TaskInit
   \   00002B   7903         MOV     R1,#0x3
   \   00002D   12....       LCALL   ??MT_TaskInit?relay
    121          #endif
    122            APS_Init( taskID++ );
   \   000030                ; Setup parameters for call to function APS_Init
   \   000030   7904         MOV     R1,#0x4
   \   000032   12....       LCALL   ??APS_Init?relay
    123          #if defined ( ZIGBEE_FRAGMENTATION )
    124            APSF_Init( taskID++ );
   \   000035                ; Setup parameters for call to function APSF_Init
   \   000035   7905         MOV     R1,#0x5
   \   000037   12....       LCALL   ??APSF_Init?relay
    125          #endif
