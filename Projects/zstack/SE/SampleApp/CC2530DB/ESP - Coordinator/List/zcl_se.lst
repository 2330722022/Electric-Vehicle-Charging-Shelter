    875          /*********************************************************************
    876           * @fn      zclSE_ProcessInCmd_SimpleMeter_GetProfileCmd
    877           *
    878           * @brief   Process in the received Get Profile Command.
    879           *
    880           * @param   pInMsg - pointer to the incoming message
    881           *
    882           * @return  ZStatus_t - ZFailure @ Unsupported
    883           *                      ZCL_STATUS_CMD_HAS_RSP @ Supported and do 
    884           *                                           not need default rsp
    885           *                      ZCL_STATUS_INVALID_FIELD @ Range checking 
    886           *                                           failure
    887           *                      
    888           */
    889          static ZStatus_t zclSE_ProcessInCmd_SimpleMeter_GetProfileCmd( zclIncoming_t *pInMsg,
    890                                                                          zclSE_AppCallbacks_t *pCBs )
    891          {
    892            if ( pCBs->pfnSimpleMeter_GetProfileCmd )
    893            {
    894              zclCCGetProfileCmd_t cmd;
    895              
    896              cmd.channel = pInMsg->pData[0];
    897              cmd.endTime = osal_build_uint32( &pInMsg->pData[1], 4 );
    898              cmd.numOfPeriods = pInMsg->pData[5];
    899                  
    900              // Range checking
    901              if ( cmd.channel > MAX_INTERVAL_CHANNEL_SE_SIMPLE_METERING )
    902              {
    903                return ZCL_STATUS_INVALID_FIELD;
    904              }
    905              pCBs->pfnSimpleMeter_GetProfileCmd( &cmd, &(pInMsg->msg->srcAddr), 
    906                                                 pInMsg->hdr.transSeqNum  );
    907              
    908              return ZCL_STATUS_CMD_HAS_RSP;
    909            }
    910            else
    911            {
    912              return ZFailure; 
    913            }
    914          }
