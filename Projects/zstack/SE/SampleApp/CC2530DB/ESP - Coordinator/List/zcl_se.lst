    136          #ifdef ZCL_SIMPLE_METERING
    137          /*********************************************************************
    138           * @fn      zclSE_SimpleMetering_Send_GetProfileCmd
    139           *
    140           * @brief   Call to send out a Get Profile Command
    141           *
    142           * @param   srcEP - Sending application's endpoint
