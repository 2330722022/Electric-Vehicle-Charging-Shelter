   1329          /*********************************************************************
   1330           * @fn      zclSE_ProcessInCmd_Message_CancelMessage
   1331           *
   1332           * @brief   Process in the received Cancel Message Command.
   1333           *
   1334           * @param   pInMsg - pointer to the incoming message
   1335           *
   1336           * @return  ZStatus_t - ZFailure @ Unsupported
   1337           *                      ZSuccess @ Supported and send default rsp
   1338           */
   1339          static ZStatus_t zclSE_ProcessInCmd_Message_CancelMessage( zclIncoming_t *pInMsg,
   1340                                                                      zclSE_AppCallbacks_t *pCBs )
   1341          {
   1342            if ( pCBs->pfnMessage_CancelMessage )
   1343            {
   1344              zclCCCancelMessage_t cmd;
   1345              
   1346              cmd.messageId = osal_build_uint32( &(pInMsg->pData[0]), 4 );
   1347              
   1348              // Message Control
   1349              cmd.messageCtrl.transmissionMode = pInMsg->pData[4] & 0x03;    // bit 0&1
   1350              cmd.messageCtrl.importance = ( pInMsg->pData[4] >> SE_PROFILE_MSGCTRL_IMPORTANCE ) & 0x03; // bit 2&3
   1351              cmd.messageCtrl.confirmationRequired = ( pInMsg->pData[4] >> SE_PROFILE_MSGCTRL_CONFREQUIRED ) & 0x01;  // bit 7
   1352              
   1353              pCBs->pfnMessage_CancelMessage( &cmd, &(pInMsg->msg->srcAddr), 
   1354                                             pInMsg->hdr.transSeqNum );
   1355               
   1356              return ZSuccess;
   1357            }
   1358            else
   1359            {
   1360              return ZFailure;
   1361            }
   1362          }
   1363          
