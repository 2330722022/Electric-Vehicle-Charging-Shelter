   1374           */
   1375          static ZStatus_t zclSE_ProcessInCmd_Message_GetLastMessage( zclIncoming_t *pInMsg,
   1376                                                                       zclSE_AppCallbacks_t *pCBs )
   1377          {
   1378            if ( pCBs->pfnMessage_GetLastMessage )
   1379            {    
   1380              pCBs->pfnMessage_GetLastMessage( &(pInMsg->msg->srcAddr), pInMsg->hdr.transSeqNum );
   1381              return ZCL_STATUS_CMD_HAS_RSP;
   1382            }
   1383            else
   1384            {
   1385              return ZFailure;
   1386            }
   1387          }
