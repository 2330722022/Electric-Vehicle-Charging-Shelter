   \                                 In  segment XDATA_Z, align 1, keep-with-next
    116          static uint8 espTaskID;                              // esp osal task id
   \                     espTaskID:
   \   000000                DS 1
   \   000001                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    117          static afAddrType_t ipdAddr;                         // destination address of in premise display
   \                     ipdAddr:
   \   000000                DS 12
   \   00000C                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    118          static afAddrType_t pctAddr;                         // destination address of PCT
   \                     pctAddr:
   \   000000                DS 12
   \   00000C                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    119          static afAddrType_t loadControlAddr;                 // destination address of load control device
   \                     loadControlAddr:
   \   000000                DS 12
   \   00000C                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    120          static zAddrType_t simpleDescReqAddr[2];             // destination addresses for simple desc request
   \                     simpleDescReqAddr:
   \   000000                DS 18
   \   000012                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    121          static uint8 matchRspCount = 0;                      // number of received match responses
   \                     matchRspCount:
   \   000000                DS 1
   \   000001                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    122          static zAddrType_t dstMatchAddr;                     // generic destination address used for match descriptor request
   \                     dstMatchAddr:
   \   000000                DS 9
   \   000009                REQUIRE __INIT_XDATA_Z

   \                                 In  segment XDATA_Z, align 1, keep-with-next
    123          static zclCCLoadControlEvent_t loadControlCmd;       // command structure for load control command
   \                     loadControlCmd:
   \   000000                DS 24
   \   000018                REQUIRE __INIT_XDATA_Z
    124          
    125          // cluster list used for match desc req

   \                                 In  segment XDATA_ROM_C, align 1
    126          static const cId_t matchClusterList[1] =
   \                     matchClusterList:
   \   000000   0107         DW 1793
