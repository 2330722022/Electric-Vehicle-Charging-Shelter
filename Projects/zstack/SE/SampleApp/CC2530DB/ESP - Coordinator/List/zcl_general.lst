   2757                  alarm.alarmCode = *pData++;
   2758                  alarm.clusterID = BUILD_UINT16( pData[0], pData[1] );
   2759                  pData += 2;
   2760                  alarm.timeStamp = osal_build_uint32( pData, 4 );
   2761          
   2762                  pCBs->pfnAlarm( &alarm );
   2763                }
   2764                break;
   2765          
   2766              case COMMAND_ALARMS_GET_RSP:
