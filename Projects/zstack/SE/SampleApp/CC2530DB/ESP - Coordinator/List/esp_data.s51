//  150 {
//  151 
//  152   // *** General Basic Cluster Attributes ***
//  153   {
//  154     ZCL_CLUSTER_ID_GEN_BASIC,             // Cluster IDs - defined in the foundation (ie. zcl.h)
//  155     {  // Attribute record
//  156       ATTRID_BASIC_ZCL_VERSION,           // Attribute ID - Found in Cluster Library header (ie. zcl_general.h)
//  157       ZCL_DATATYPE_UINT8,                 // Data Type - found in zcl.h
//  158       ACCESS_CONTROL_READ,                // Variable access control - found in zcl.h
//  159       (void *)&espZCLVersion              // Pointer to attribute variable
//  160     }
//  161   },
//  162   {
//  163     ZCL_CLUSTER_ID_GEN_BASIC,
//  164     { // Attribute record
//  165       ATTRID_BASIC_HW_VERSION,
//  166       ZCL_DATATYPE_UINT8,
//  167       ACCESS_CONTROL_READ,
//  168       (void *)&espHWVersion
//  169     }
//  170   },
//  171   {
//  172     ZCL_CLUSTER_ID_GEN_BASIC,
//  173     { // Attribute record
//  174       ATTRID_BASIC_MANUFACTURER_NAME,
//  175       ZCL_DATATYPE_CHAR_STR,
//  176       ACCESS_CONTROL_READ,
//  177       (void *)espManufacturerName
//  178     }
//  179   },
//  180   {
//  181     ZCL_CLUSTER_ID_GEN_BASIC,
//  182     { // Attribute record
//  183       ATTRID_BASIC_MODEL_ID,
//  184       ZCL_DATATYPE_CHAR_STR,
//  185       ACCESS_CONTROL_READ,
//  186       (void *)espModelId
//  187     }
//  188   },
//  189   {
//  190     ZCL_CLUSTER_ID_GEN_BASIC,
//  191     { // Attribute record
//  192       ATTRID_BASIC_DATE_CODE,
//  193       ZCL_DATATYPE_CHAR_STR,
//  194       ACCESS_CONTROL_READ,
//  195       (void *)espDateCode
//  196     }
//  197   },
//  198   {
//  199     ZCL_CLUSTER_ID_GEN_BASIC,
//  200     { // Attribute record
//  201       ATTRID_BASIC_POWER_SOURCE,
//  202       ZCL_DATATYPE_ENUM8,
//  203       ACCESS_CONTROL_READ,
//  204       (void *)&espPowerSource
//  205     }
//  206   },
//  207   {
//  208     ZCL_CLUSTER_ID_GEN_BASIC,
//  209     { // Attribute record
//  210       ATTRID_BASIC_LOCATION_DESC,
//  211       ZCL_DATATYPE_CHAR_STR,
//  212       (ACCESS_CONTROL_READ | ACCESS_CONTROL_WRITE),
//  213       (void *)espLocationDescription
//  214     }
//  215   },
//  216   {
//  217     ZCL_CLUSTER_ID_GEN_BASIC,
//  218     { // Attribute record
//  219       ATTRID_BASIC_PHYSICAL_ENV,
//  220       ZCL_DATATYPE_ENUM8,
//  221       (ACCESS_CONTROL_READ | ACCESS_CONTROL_WRITE),
//  222       (void *)&espPhysicalEnvironment
//  223     }
//  224   },
//  225   {
//  226     ZCL_CLUSTER_ID_GEN_BASIC,
//  227     { // Attribute record
//  228       ATTRID_BASIC_DEVICE_ENABLED,
//  229       ZCL_DATATYPE_BOOLEAN,
//  230       (ACCESS_CONTROL_READ | ACCESS_CONTROL_WRITE),
//  231       (void *)&espDeviceEnabled
//  232     }
//  233   },
//  234 
//  235   // *** Identify Cluster Attribute ***
//  236   {
//  237     ZCL_CLUSTER_ID_GEN_IDENTIFY,
//  238     { // Attribute record
//  239       ATTRID_IDENTIFY_TIME,
//  240       ZCL_DATATYPE_UINT16,
//  241       (ACCESS_CONTROL_READ | ACCESS_CONTROL_WRITE),
//  242       (void *)&espIdentifyTime
//  243     }
//  244   },
//  245 
//  246   // *** Time Cluster Attribute ***
//  247   // In SE domain, only master clock will be used. Therefore
//  248   // mark the access control to only readable.
//  249   {
//  250     ZCL_CLUSTER_ID_GEN_TIME,
//  251     { // Attribute record
//  252       ATTRID_TIME_TIME,
