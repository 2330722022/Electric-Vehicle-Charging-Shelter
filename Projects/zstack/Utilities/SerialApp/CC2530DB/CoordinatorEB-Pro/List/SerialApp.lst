    546          
    547          /*********************************************************************
    548           * @fn      SerialApp_Send
    549           *
    550           * @brief   Send data OTA.
    551           *
    552           * @param   none
    553           *
    554           * @return  none
    555           */
    556          static void SerialApp_Send(void)
    557          {
    558          #if SERIAL_APP_LOOPBACK
    559              if (SerialApp_TxLen < SERIAL_APP_TX_MAX)
    560              {
    561                  SerialApp_TxLen += HalUARTRead(SERIAL_APP_PORT, SerialApp_TxBuf+SerialApp_TxLen+1,
    562                                                                SERIAL_APP_TX_MAX-SerialApp_TxLen);
    563              }
    564            
    565              if (SerialApp_TxLen)
    566              {
    567                (void)SerialApp_TxAddr;
    568                if (SerialApp_SafeUARTWrite(SERIAL_APP_PORT, SerialApp_TxBuf+1, SerialApp_TxLen))
    569                {
    570                  SerialApp_TxLen = 0;
    571                }
    572                else
    573                {
    574                  osal_set_event(SerialApp_TaskID, SERIALAPP_SEND_EVT);
    575                }
    576              }
    577          #else
    578              // Data is now processed in SerialApp_ProcessUARTBuffer
    579              // This function is only used for re-sending failed transmissions
    580              if (SerialApp_TxLen)
    581              {
    582                if (afStatus_SUCCESS != AF_DataRequest(&SerialApp_TxAddr,
    583                                                       (endPointDesc_t *)&SerialApp_epDesc,
    584                                                        SERIALAPP_CLUSTERID1,
    585                                                        SerialApp_TxLen+1, SerialApp_TxBuf,
    586                                                        &SerialApp_MsgID, 0, AF_DEFAULT_RADIUS))
    587                {
    588                  osal_set_event(SerialApp_TaskID, SERIALAPP_SEND_EVT);
    589                }
    590                else
    591                {
    592                  SerialApp_TxLen = 0; // Reset after successful send
    593                }
    594              }
    595          #endif
    596          }
    597          
    598          /*********************************************************************
    599           * @fn      SerialApp_Resp
    600           *
    601           * @brief   Send data OTA.
    602           *
    603           * @param   none
    604           *
    605           * @return  none
    606           */
    607          static void SerialApp_Resp(void)
    608          {
    609            if (afStatus_SUCCESS != AF_DataRequest(&SerialApp_RxAddr,
    610                                                   (endPointDesc_t *)&SerialApp_epDesc,
    611                                                    SERIALAPP_CLUSTERID2,
    612                                                    SERIAL_APP_RSP_CNT, SerialApp_RspBuf,
    613                                                   &SerialApp_MsgID, 0, AF_DEFAULT_RADIUS))
    614            {
    615              osal_set_event(SerialApp_TaskID, SERIALAPP_RESP_EVT);
    616            }
    617          }
    618          
