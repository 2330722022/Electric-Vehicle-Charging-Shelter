    282                      (void)SerialApp_SafeUARTWrite(0, (uint8*)deviceBuffer, strlen(deviceBuffer));
    283                      
    284                      if(SampleApp_NwkState != DEV_ZB_COORD)
    285                        SerialApp_DeviceConnect();              
    286                  }
    287                  else
    288                  {
    289                    // Device is no longer in the network
    290                  }
    291                  break;
    292          
