    655          /*********************************************************************
    656          *********************************************************************/
    657          void  SerialApp_DeviceConnect()              
    658          {
    659          #if ZDO_COORDINATOR
    660            
    661          #else
    662            
    663            uint16 nwkAddr;
    664            uint16 parentNwkAddr;
    665            char buff[40] = {0};
    666            
    667            HalLedBlink( HAL_LED_2, 3, 50, (1000 / 4) );
    668            
    669            nwkAddr = NLME_GetShortAddr();
    670            parentNwkAddr = NLME_GetCoordShortAddr();
    671            sprintf(buff, "[END0x%04X] Connected, parent:0x%04X\r\n", nwkAddr, parentNwkAddr);
    672            HalUARTWrite ( 0, (uint8*)buff, strlen(buff));
    673            
    674            SerialApp_TxAddr.addrMode = (afAddrMode_t)Addr16Bit;
    675            SerialApp_TxAddr.endPoint = SERIALAPP_ENDPOINT;
    676            SerialApp_TxAddr.addr.shortAddr = parentNwkAddr;
    677            
    678            buff[0] = HI_UINT16( nwkAddr );
    679            buff[1] = LO_UINT16( nwkAddr );
    680            
    681            if ( AF_DataRequest( &SerialApp_TxAddr, &SerialApp_epDesc,
    682                                 SERIALAPP_CONNECTREQ_CLUSTER,
    683                                 2,
    684                                 (uint8*)buff,
    685                                 &SerialApp_MsgID, 
    686                                 0, 
    687                                 AF_DEFAULT_RADIUS ) == afStatus_SUCCESS )
    688            {
    689            }
    690            else
    691            {
    692              // Error occurred in request to send.
    693            }
    694            
    695          #endif    //ZDO_COORDINATOR
    696          }
    697          
    698          void SerialApp_DeviceConnectRsp(uint8 *buf)
    699          {
    700          #if ZDO_COORDINATOR
    701            
    702          #else
    703            uint16 selfAddr = NLME_GetShortAddr();
    704            SerialApp_TxAddr.addrMode = (afAddrMode_t)Addr16Bit;
    705            SerialApp_TxAddr.endPoint = SERIALAPP_ENDPOINT;
    706            SerialApp_TxAddr.addr.shortAddr = BUILD_UINT16(buf[1], buf[0]);
    707            
    708            HalLedSet(HAL_LED_2, HAL_LED_MODE_ON);
    709            {
    710              char connBuf[40];
    711              sprintf(connBuf, "[END0x%04X] Connect confirm success\r\n", selfAddr);
    712              (void)SerialApp_SafeUARTWrite(0, (uint8*)connBuf, strlen(connBuf));
    713            }
    714          #endif
    715          }
    716          

