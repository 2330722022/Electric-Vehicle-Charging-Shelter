    549            
    550            SerialApp_TxAddr.addrMode = (afAddrMode_t)Addr16Bit;
    551            SerialApp_TxAddr.endPoint = SERIALAPP_ENDPOINT;
    552            SerialApp_TxAddr.addr.shortAddr = parentNwkAddr;
    553            
    554            buff[0] = HI_UINT16( nwkAddr );
    555            buff[1] = LO_UINT16( nwkAddr );
    556            
    557            if ( AF_DataRequest( &SerialApp_TxAddr, &SerialApp_epDesc,
    558                                 SERIALAPP_CONNECTREQ_CLUSTER,
    559                                 2,
    560                                 (uint8*)buff,
    561                                 &SerialApp_MsgID, 
    562                                 0, 
    563                                 AF_DEFAULT_RADIUS ) == afStatus_SUCCESS )
    564            {
    565            }
    566            else
    567            {
    568              // Error occurred in request to send.
    569            }
    570            
    571          #endif    //ZDO_COORDINATOR
    572          }
    573          
