    442                  SerialApp_TxLen = 0;
    443                }
    444                else
    445                {
    446                  osal_set_event(SerialApp_TaskID, SERIALAPP_SEND_EVT);
    447                }
    448              }
    449          #else
    450              // Data is now processed in SerialApp_ProcessUARTBuffer
    451              // This function is only used for re-sending failed transmissions
    452              if (SerialApp_TxLen)
    453              {
    454                if (afStatus_SUCCESS != AF_DataRequest(&SerialApp_TxAddr,
    455                                                       (endPointDesc_t *)&SerialApp_epDesc,
    456                                                        SERIALAPP_CLUSTERID1,
    457                                                        SerialApp_TxLen+1, SerialApp_TxBuf,
    458                                                        &SerialApp_MsgID, 0, AF_DEFAULT_RADIUS))
    459                {
    460                  osal_set_event(SerialApp_TaskID, SERIALAPP_SEND_EVT);
    461                }
    462                else
    463                {
    464                  SerialApp_TxLen = 0; // Reset after successful send
    465                }
    466              }
    467          #endif
    468          }
