    580            SerialApp_TxAddr.endPoint = SERIALAPP_ENDPOINT;
    581            SerialApp_TxAddr.addr.shortAddr = BUILD_UINT16(buf[1], buf[0]);
    582            
    583            HalLedSet(HAL_LED_2, HAL_LED_MODE_ON);
    584            (void)SerialApp_SafeUARTWrite(0, (uint8*)"< connect success>\n", 23);
    585          #endif
    586          }
